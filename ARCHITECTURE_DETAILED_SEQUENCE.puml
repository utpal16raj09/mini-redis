@startuml MiniRedis_Detailed_Sequence_Diagram
!theme vibrant
autonumber

box "Client Application" #FFF3CD
actor Client as "redis-cli / Client App"
end box

box "Network Reactor Subsystem" #D1ECF1
participant Epoll as "EventLoop (epoll_wait)"
participant ServerSock as "Socket (Listening fd)"
participant Conn as "Connection Object (client_fd)"
end box

box "Protocol & Router Subsystem" #D4EDDA
participant Parser as "RespParser"
participant Router as "Router Dispatcher"
end box

box "Storage & Persistence Subsystem" #F8D7DA
participant DB as "Database Engine"
participant AOF as "AofEngine"
end box

== 1. Connection Initialization & Epoll Registration ==
Client -> ServerSock : TCP SYN Connection Request
Reactor -> ServerSock : epoll_wait detects read event on server socket
ServerSock -> ServerSock : acceptConnection(client_ip, client_port)
ServerSock -> Conn : Create Connection(client_fd, router)
Reactor -> Reactor : fcntl(client_fd, O_NONBLOCK)
Reactor -> Reactor : epoll_ctl(ADD, client_fd, EPOLLIN)

== 2. Request Parsing & Execution Lifecycle ==
Client -> Conn : Sends RESP payload: *3\r\n$3\r\nSET\r\n$4\r\nname\r\n$9\r\nMiniRedis\r\n
Reactor -> Conn : epoll_wait triggers EPOLLIN event -> Connection::onRead()
Conn -> Conn : recv(client_fd, buf) -> append to read_buffer_
loop Parse Frames until buffer incomplete
    Conn -> Parser : RespParser::parse(read_buffer_)
    Parser -> Parser : Validate prefix (*), CRLF (\r\n), lengths ($3, $4, $9)
    Parser --> Conn : Return RespValue Array ["SET", "name", "MiniRedis"]
    Conn -> Router : Router::dispatch(RespValue)
    Router -> Router : Transform command string to UPPERCASE ("SET")
    Router -> DB : Database::set("name", "MiniRedis")
    DB -> DB : store_["name"] = Value{String, "MiniRedis"}
    DB --> Router : Success
    alt Command Mutates State & log_to_aof == true
        Router -> AOF : AofEngine::append(RespValue)
        AOF -> AOF : serialize() command -> file_.write() & flush()
        AOF --> Router : Flushed to appendonly.aof
    end
    Router --> Conn : Return RespValue (+OK\r\n)
    Conn -> Conn : Serialize "+OK\r\n" -> append to write_buffer_
end
Conn -> Conn : Connection::onWrite() -> send(client_fd, write_buffer_, MSG_DONTWAIT)
alt Unsent bytes remaining in write_buffer_
    Conn --> Reactor : hasPendingWrites() == true
    Reactor -> Reactor : epoll_ctl(MOD, client_fd, EPOLLIN | EPOLLOUT)
else Write buffer completely flushed
    Conn --> Reactor : hasPendingWrites() == false
    Reactor -> Reactor : epoll_ctl(MOD, client_fd, EPOLLIN)
end
Conn --> Client : TCP ACK + Response "+OK\r\n"

== 3. Active TTL Expiration Loop (Background Timer) ==
Reactor -> Reactor : epoll_wait timeout (100ms interval)
Reactor -> DB : Database::purgeExpiredKeys(20)
DB -> DB : Sample 20 keys with expire_at timestamp
loop For each sampled key
    alt steady_clock::now() >= expire_at
        DB -> DB : store_.erase(key) [Evict expired key]
    end
end
DB --> Reactor : Return total evicted key count

@enduml
